<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Home screens that this launcher replaces. The stock one is never disabled, so it
         remains a fail-safe fallback. Add your vendor's launcher package if it is missing. -->
    <string-array name="stock_launchers">
        <item>com.mitv.tvhome</item>
        <item>com.google.android.tvlauncher</item>
        <item>com.google.android.apps.tv.launcherx</item>
        <item>com.google.android.leanbacklauncher</item>
    </string-array>

    <!-- Dock tiles on a fresh install. After that the user owns the list: long-press OK on a
         tile in the grid to pin it (appended at the end) or remove it from the dock. -->
    <string-array name="dock_defaults">
        <item>nlrc_pendrive</item>
        <item>org.smarttube.stable</item>
    </string-array>

    <!-- Apps never shown as tiles (Live TV is reachable via the Inputs menu instead). -->
    <string-array name="hidden_apps">
        <item>com.realtek.tv</item>
        <item>com.realtek.dtv</item>
        <item>com.realtek.dtmb</item>
        <item>com.realtek.tv.atsc</item>
        <item>com.realtek.tv.atv</item>
        <item>com.realtek.tv.isdb</item>
        <item>com.droidlogic.tvinput</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. -->
    <string name="live_tv_package" translatable="false">com.xiaomi.mitv.tvplayer</string>

    <!-- Hardware source ids for TVs that expose TV inputs through Xiaomi's MiTVTVPlayer
         (Amlogic Mi TV / Redmi TV). Values come from MiTVTVPlayer's ExternalSourceActivity;
         the two arrays are parallel and in menu order (index 0 = first row in the Inputs menu).

         Measured on this Mi TV 4A (xmen / Amlogic, platformid 659), 2026-10-26 - see docs §15:
           * HDMI 3 = 25  -> VERIFIED. The stock settings switch to HDMI 3 sends
                             com.xiaomi.mitv.tvplayer.EXTSRC_PLAY with input=25, and 25 is the only
                             id that creates a session (Hdmi1InputService/HW5, the single HDMI
                             passthrough this ROM registers).
           * HDMI 2 = 24  -> from /system/etc/mitv.config.xml (hdmi2_order). NOT verified yet: no
                             device is plugged into HDMI 2, so the framework answers
                             "can not get input source" and nothing switches.
           * HDMI 1 = 23  -> same as above (hdmi3_order in mitv.config.xml, the internal numbering
                             runs opposite to the labels on the back panel).
         The old guesses 2 / 18 / 19 do not exist on this ROM - they only ever opened the player
         without switching anything.

         Plug a device into a port and run tools/probe_hdmi.sh to confirm its id; then fix the
         number here (one id + one label per port, same position in both arrays). -->
    <integer-array name="source_hdmi">
        <item>23</item>
        <item>24</item>
        <item>25</item>
    </integer-array>
    <string-array name="hdmi_labels">
        <item>HDMI 1</item>
        <item>HDMI 2</item>
        <item>HDMI 3</item>
    </string-array>
    <integer name="source_av">17</integer>

    <!-- Boot-only input restore. If the last source was Live TV, it is reopened directly;
         otherwise all external sources (HDMI 1/2/3 + AV) are checked: the remembered last source
         wins, then auto_hdmi_index (0-based, 2 = HDMI 3), then config order. auto_hdmi_boot_delay_ms
         is the first check after boot; auto_hdmi_boot_window_ms is how long to keep waiting for a
         slow set-top box. After that the watcher stops - it does not steal the screen while the TV
         is being used. The TvInput hardware id fragment is the fallback for the auto_hdmi_index port
         when the Xiaomi SourceManager is unavailable; on this Mi TV 4A the framework registers
         Hdmi1InputService/HW5 for HDMI 3. -->
    <integer name="auto_hdmi_index">2</integer>
    <integer name="auto_hdmi_boot_delay_ms">10000</integer>
    <integer name="auto_hdmi_boot_window_ms">60000</integer>
    <string name="auto_hdmi_tvinput_hint" translatable="false">HW5</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

</resources>
